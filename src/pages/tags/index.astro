---
import BlogBaseLayout from '../../layouts/BlogBaseLayout.astro';
import { getPublishedPosts, getAllTags } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = await getAllTags();
const count = (t: string) => posts.filter((p) => p.data.tags.includes(t)).length;
---

<BlogBaseLayout title="Tags — The Forge" description="Browse posts by topic.">
  <section class="tags-index">
    <p class="eyebrow"><a href="/">// the forge</a> / tags</p>
    <h1>Tags</h1>
    <ul class="tag-cloud">
      {tags.map((t) => (
        <li>
          <a class="tag" href={`/tags/${t}`}>#{t}<span class="count">{count(t)}</span></a>
        </li>
      ))}
    </ul>
  </section>
</BlogBaseLayout>

<style>
  .tags-index {
    max-width: var(--w-content);
    margin: 0 auto;
    padding: 2.5rem 0 3rem;
  }
  .eyebrow {
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }
  .eyebrow a { color: var(--text-muted); border-bottom: none; }
  .eyebrow a:hover { color: var(--accent-bright); }
  .tags-index h1 { margin: 0 0 1.5rem; }
  .tag-cloud {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .count {
    color: var(--text-muted);
    font-size: 0.72rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 0.45em;
  }
</style>
