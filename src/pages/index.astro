---
const title = 'apps.digitalgrease';
const description = 'Privacy-first, local-first apps by Digital Grease.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main>
      <h1>apps.digitalgrease</h1>
      <p>Scaffolding in progress. Real content lands in Phase 2.</p>
    </main>
    <style>
      :root {
        color-scheme: dark;
        --bg: #000;
        --text: #d4d4d4;
        --accent: #8b7fa8;
      }
      html, body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-monospace, 'Courier New', monospace;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
      }
      h1 {
        color: var(--accent);
        font-weight: 700;
        letter-spacing: 0.02em;
      }
    </style>
  </body>
</html>
