---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';

const apps = (await getCollection('apps')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const title = 'apps.digitalgrease — privacy-first, local-first apps';
const description =
  'Open-source privacy tools by Digital Grease: Fauxx, Obscura, Effigy, Signet. Local-first, no accounts, no telemetry.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <p class="eyebrow">// digitalgrease / apps</p>
    <h1>Privacy-first, local-first apps.</h1>
    <p class="lead">
      A small portfolio of open-source tools for the threat model of
      <em>now</em> — biographical retrieval by LLMs, voice-deepfake vishing,
      behavioral profiling by ad-tech, and the slow accretion of data broker
      records. All offline by default. No accounts. No telemetry.
    </p>
  </section>

  <section class="grid" aria-label="Apps">
    {apps.map((app) => <AppCard app={app} />)}
  </section>

  <section class="fine-print">
    <p>
      Each app's source, license, and privacy notes live in its GitHub
      repository. Questions, issues, and contributions are welcome there.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--w-content);
    margin: 0 auto;
    padding: 3rem 0 2.5rem;
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--accent-bright);
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 62ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    padding: 1rem 0 3rem;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  .fine-print {
    max-width: var(--w-content);
    margin: 0 auto;
    padding: 1rem 0 2rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
</style>
