---
// The blog landing, served at blog.digitalgrease.dev/ via a Caddy rewrite to
// /blog-home.html. Forge-hero + Digital/Analog tiles (with honest post counts) +
// a cross-axis recent feed; the full archive lives at /posts.
import BlogBaseLayout from '../layouts/BlogBaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getHomeFeed, getCategoryCounts } from '../lib/posts';

const recent = await getHomeFeed(4);
const counts = await getCategoryCounts();
const title = 'The Forge — digitalgrease';
const description =
  'Notes from the overlap between servers and steel, code and craft. Chasing a clean signal in the noise.';
---

<BlogBaseLayout title={title} description={description} canonicalPath="/">
  <section class="hero-intro">
    <p class="eyebrow">// digitalgrease / the forge</p>
    <h1>The Forge</h1>
    <p class="lead">{description}</p>
    <p class="who">
      By digitalgrease: security engineer, maker, homesteader.
      <a href="/about">Read the story →</a>
    </p>
  </section>

  <figure class="forge-hero">
    <img
      src="/forge/technoforge.jpg"
      alt="The Forge — where code is forged in fire"
      loading="eager"
      decoding="async"
    />
    <div class="forge-hero__overlay"></div>
  </figure>

  <section class="dichotomy" aria-label="Browse by world">
    <a class="axis-tile" data-cat="Digital" href="/category/digital">
      <span class="axis-icon" aria-hidden="true">☠</span>
      <span class="axis-name">Digital</span>
      <span class="axis-count">{counts.Digital} post{counts.Digital === 1 ? '' : 's'}</span>
      <span class="axis-blurb">Security research, offensive tooling, engineering write-ups. The work that lives in terminals and threat models.</span>
    </a>
    <a class="axis-tile" data-cat="Analog" href="/category/analog">
      <span class="axis-icon" aria-hidden="true">🔥</span>
      <span class="axis-name">Analog</span>
      <span class="axis-count">{counts.Analog} post{counts.Analog === 1 ? '' : 's'}</span>
      <span class="axis-blurb">Blacksmithing, farming, building things with your hands. The work after the screen goes dark and the forge starts to glow.</span>
    </a>
  </section>

  <section class="recent" aria-label="Recent posts">
    <div class="recent-head">
      <h2>Recent</h2>
      <a href="/posts" class="all-link">All posts →</a>
    </div>
    <div class="post-list">
      {recent.map((p) => <PostCard entry={p} />)}
    </div>
    <p class="apps-ref">
      Building things, not just writing about them. Tools &amp; apps live at
      <a href="https://apps.digitalgrease.dev">apps.digitalgrease.dev ↗</a>.
    </p>
  </section>
</BlogBaseLayout>

<style>
  .hero-intro {
    max-width: var(--w-content);
    margin: 0 auto;
    padding: 2rem 0 1rem;
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }

  .hero-intro h1 { margin: 0 0 1rem; }

  .lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 60ch;
    margin: 0;
  }

  .who {
    margin: 0.85rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .who a { color: var(--accent); border-bottom: none; white-space: nowrap; }
  .who a:hover { color: var(--accent-bright); }

  .forge-hero { max-width: var(--w-content); margin-inline: auto; }

  .dichotomy {
    max-width: var(--w-content);
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .axis-tile {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'icon name count' 'blurb blurb blurb';
    gap: 0.25rem 0.75rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-lg);
    background: var(--card);
    color: var(--text);
    border-bottom: 1px solid currentColor;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .axis-tile[data-cat='Digital'] { color: var(--info); box-shadow: 0 0 14px rgba(0, 204, 204, 0.12); }
  .axis-tile[data-cat='Analog'] { color: var(--warn); box-shadow: 0 0 14px rgba(255, 153, 51, 0.12); }
  .axis-tile:hover { transform: translateY(-2px); }

  .axis-icon { grid-area: icon; font-size: 1.4rem; line-height: 1; }
  .axis-name {
    grid-area: name;
    align-self: center;
    font-family: 'Share Tech Mono', monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 1.05rem;
  }
  .axis-count {
    grid-area: count;
    align-self: center;
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .axis-blurb { grid-area: blurb; color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; }

  .recent { max-width: var(--w-content); margin: 2.5rem auto 0; }

  .recent-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .recent-head h2 { margin: 0; }
  .all-link { font-size: 0.9rem; color: var(--accent); border-bottom: none; }
  .all-link:hover { color: var(--accent-bright); }

  .post-list { display: grid; grid-template-columns: 1fr; gap: 1rem; }

  .apps-ref {
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .apps-ref a { color: var(--accent); border-bottom: none; }
  .apps-ref a:hover { color: var(--accent-bright); }

  @media (max-width: 720px) {
    .dichotomy { grid-template-columns: 1fr; }
  }
</style>
