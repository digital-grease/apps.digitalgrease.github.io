---
import { getCollection, render } from 'astro:content';
import AppLayout from '../layouts/AppLayout.astro';
import ProjectLayout from '../layouts/ProjectLayout.astro';
import type { GetStaticPaths } from 'astro';

// Apps and projects share the root namespace (no id collisions): /fauxx is an app,
// /eve is a project. Both render a detail page on the apps subdomain.
export const getStaticPaths = (async () => {
  const apps = await getCollection('apps');
  const projects = await getCollection('projects');
  return [
    ...apps.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'app', entry } })),
    ...projects.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'project', entry } })),
  ];
}) satisfies GetStaticPaths;

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
---

{kind === 'app' ? (
  <AppLayout app={entry}>
    <Content />
  </AppLayout>
) : (
  <ProjectLayout project={entry}>
    <Content />
  </ProjectLayout>
)}
