---
import BlogBaseLayout from '../../layouts/BlogBaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/posts';

const posts = await getPublishedPosts();
const counts = await getTagCounts();
// Only multi-post tags cluster; singletons are demoted (they'd be dead-end pages).
const clusterTags = [...counts.entries()].filter(([, c]) => c >= 2).sort((a, b) => b[1] - a[1]);

const title = 'The Forge — digitalgrease blog';
const description =
  'Notes from the overlap between servers and steel, code and craft. Chasing a clean signal in the noise.';
---

<BlogBaseLayout title={title} description={description}>
  <section class="blog-hero">
    <p class="eyebrow"><a href="/">// the forge</a> / archive</p>
    <h1>All Posts</h1>
    <p class="lead">
      Everything, newest first. Or browse by
      <a href="/category/digital">Digital</a> / <a href="/category/analog">Analog</a>.
    </p>
  </section>

  <div class="post-list">
    {posts.map((p) => <PostCard entry={p} />)}
  </div>

  {clusterTags.length > 0 && (
    <section class="tag-cloud" aria-label="Topics">
      <p class="tag-cloud-head"><a href="/tags">// browse all topics →</a></p>
      <ul>
        {clusterTags.map(([t, c]) => (
          <li>
            <a href={`/tags/${t}`} style={`font-size:${(0.85 + Math.min(c, 6) * 0.07).toFixed(2)}rem`}>
              #{t} <span class="tag-n">{c}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BlogBaseLayout>

<style>
  .blog-hero {
    max-width: var(--w-content);
    margin: 0 auto;
    padding: 2.5rem 0 2rem;
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }

  .blog-hero h1 {
    margin: 0 0 1rem;
    color: var(--accent-bright);
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 60ch;
  }

  .post-list {
    max-width: var(--w-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1rem 0 2.5rem;
  }

  .tag-cloud {
    max-width: var(--w-content);
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--border);
  }

  .tag-cloud-head {
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem;
  }
  .tag-cloud-head a { color: var(--text-muted); border-bottom: none; }
  .tag-cloud-head a:hover { color: var(--accent-bright); }
  .tag-n { color: var(--text-muted); font-size: 0.72rem; }

  .tag-cloud ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .tag-cloud a {
    color: var(--text-muted);
    font-size: 0.9rem;
    border-bottom: none;
  }

  .tag-cloud a:hover { color: var(--accent-bright); }
</style>
