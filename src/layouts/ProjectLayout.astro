---
// On-site page for a `projects` collection entry (apps subdomain, tokens theme).
// Gives the post→project card somewhere to land that isn't a bare GitHub redirect:
// project detail + a "Source ↗" link to the repo + reverse links to its write-ups.
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { BLOG_ORIGIN } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, tagline, kind, repo, stack, license, status, accent } = project.data;

// Reverse link: posts that declared `project: <this id>` in frontmatter.
const writeups = (await getCollection('posts')).filter((p) => p.data.project === project.id);

const pageTitle = `${name} — apps.digitalgrease`;
---

<BaseLayout title={pageTitle} description={tagline} ogType="article">
  <article class="project-page" style={accent ? `--project-accent: ${accent};` : undefined}>
    <header class="hero">
      <p class="eyebrow">// {kind}</p>
      <h1>{name}</h1>
      <p class="tagline">{tagline}</p>

      <dl class="meta">
        <div>
          <dt>Status</dt>
          <dd>{status}</dd>
        </div>
        <div>
          <dt>License</dt>
          <dd>{license}</dd>
        </div>
        {stack.length > 0 && (
          <div>
            <dt>Stack</dt>
            <dd>{stack.join(' · ')}</dd>
          </div>
        )}
        <div>
          <dt>Source</dt>
          <dd><a href={repo} rel="noopener">{repo.replace('https://', '')} ↗</a></dd>
        </div>
      </dl>
    </header>

    <div class="body"><slot /></div>

    {writeups.length > 0 && (
      <aside class="writeups">
        <p class="writeups-head">// written about on The Forge</p>
        <ul>
          {writeups.map((post) => (
            <li><a href={`${BLOG_ORIGIN}/posts/${post.id}`}>{post.data.title} ↗</a></li>
          ))}
        </ul>
      </aside>
    )}

    <nav class="foot-nav">
      <a href="/">← All projects</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-page {
    max-width: var(--w-content);
    margin: 0 auto;
  }

  .hero {
    padding: 2rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 36px;
    height: 3px;
    background: var(--project-accent, var(--accent));
  }
  .eyebrow {
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 1.25rem 0 0.5rem;
  }
  .hero h1 { margin: 0 0 0.5rem; color: var(--project-accent, var(--accent-bright)); }
  .tagline { font-size: 1.1rem; color: var(--text); margin: 0 0 1.5rem; }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .meta div { display: flex; flex-direction: column; }
  .meta dt {
    color: var(--text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.2rem;
  }
  .meta dd { margin: 0; color: var(--text); word-break: break-word; }

  .writeups {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .writeups-head { color: var(--text-muted); font-size: 0.82rem; letter-spacing: 0.08em; margin: 0 0 0.6rem; }
  .writeups ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .writeups a { color: var(--accent-bright); }

  .foot-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
</style>
